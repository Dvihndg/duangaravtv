# Môi trường ứng dụng (production / development)
APP_ENV=development

# Chuỗi kết nối CSDL (Mặc định SQLite cục bộ hoặc PostgreSQL)
DATABASE_URL=sqlite:///./garage.db
# DATABASE_URL=postgresql+pg8000://garage_user:garage_password@localhost:5432/garage_db

# Khóa bí mật JWT
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =============================================
# AI Configuration — Google Gemini (Primary)
# Lấy API key tại: https://aistudio.google.com/api-keys
# =============================================
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-flash-latest

# DeepSeek / OpenAI-compatible (Fallback, để trống nếu không dùng)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# OpenAI (Tùy chọn)
OPENAI_API_KEY=

# Thuế và Tiền tệ
VAT_RATE=0.10
DEFAULT_CURRENCY=VND

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
# Only enable for an explicit local demo; never use as production persistence.
ENABLE_OFFLINE_DEMO=false

# Optional local seed credentials; leave unset in production and provision via a secret manager.
DEFAULT_ADMIN_PASSWORD=
DEFAULT_RECEPTIONIST_PASSWORD=
DEFAULT_TECHNICIAN_PASSWORD=
DEFAULT_CASHIER_PASSWORD=
INITIAL_ADMIN_PASSWORD=
