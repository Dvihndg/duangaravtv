# Môi trường ứng dụng (production / development)
APP_ENV=development

# Chuỗi kết nối CSDL (Mặc định SQLite cục bộ hoặc PostgreSQL)
DATABASE_URL=sqlite:///./garage.db
# DATABASE_URL=postgresql+pg8000://garage_user:garage_password@localhost:5432/garage_db

# Khóa bí mật JWT
SECRET_KEY=garage-vtv-prod-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =============================================
# AI Configuration — Google Gemini (Primary)
# Lấy API key tại: https://aistudio.google.com/api-keys
# =============================================
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-flash-latest

# DeepSeek / OpenAI-compatible (Fallback, để trống nếu không dùng)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# OpenAI (Tùy chọn)
OPENAI_API_KEY=

# Thuế và Tiền tệ
VAT_RATE=0.10
DEFAULT_CURRENCY=VND
