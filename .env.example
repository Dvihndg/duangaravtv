# Môi trường ứng dụng (production / development)
APP_ENV=development

# Chuỗi kết nối CSDL (Mặc định SQLite cục bộ hoặc PostgreSQL)
DATABASE_URL=sqlite:///./garage.db
# DATABASE_URL=postgresql+pg8000://garage_user:garage_password@localhost:5432/garage_db

# Khóa bí mật JWT
SECRET_KEY=garage-vtv-prod-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cấu hình AI Provider (fallback / gemini / openai / ollama)
AI_PROVIDER=fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Thuế và Tiền tệ
VAT_RATE=0.10
DEFAULT_CURRENCY=VND
