{
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/health",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/admin",
      "dest": "admin.html"
    },
    {
      "src": "/login",
      "dest": "login.html"
    },
    {
      "src": "/customer",
      "dest": "customer.html"
    },
    {
      "src": "/styles.css",
      "dest": "styles.css"
    },
    {
      "src": "/app.js",
      "dest": "app.js"
    },
    {
      "src": "/logo.png",
      "dest": "logo.png"
    },
    {
      "src": "/",
      "dest": "index.html"
    }
  ]
}
