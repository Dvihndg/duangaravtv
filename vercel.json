{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/health",
      "dest": "api/index.py"
    },
    {
      "src": "/admin",
      "dest": "admin.html"
    },
    {
      "src": "/login",
      "dest": "login.html"
    },
    {
      "src": "/customer",
      "dest": "customer.html"
    },
    {
      "src": "/styles.css",
      "dest": "styles.css"
    },
    {
      "src": "/app.js",
      "dest": "app.js"
    },
    {
      "src": "/logo.png",
      "dest": "logo.png"
    },
    {
      "src": "/",
      "dest": "index.html"
    }
  ]
}
