@startuml
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam activityBackgroundColor #1e293b
skinparam activityBorderColor #0891b2
skinparam activityStartColor #10b981
skinparam activityEndColor #f43f5e
skinparam activityBarColor #38bdf8
skinparam align center

start

:Khách hàng mang xe đến Garage;
:Lễ tân kiểm tra thông tin Khách hàng & Xe trong hệ thống;

if (Thông tin Xe đã tồn tại?) then (Có)
    :Chọn Xe từ danh sách hệ thống DB;
else (Chưa có)
    :Đăng ký mới Khách hàng & Thông tin Xe;
endif

:Ghi nhận số Km Odometer & Mô tả triệu chứng ban đầu;
:Kích hoạt AI Assistant đánh giá mức độ ưu tiên & chẩn đoán sơ bộ;

if (Sự cố thuộc mức Độ Ưu Tiên Nặng / Khẩn Cấp?) then (Khẩn cấp)
    :Đánh dấu Priority = CRITICAL;
    :Điều phối ngay cho KTV Trưởng kiểm tra trực tiếp;
else (Thường / Bảo dưỡng)
    :Đánh dấu Priority = NORMAL;
    :Tạo Phiếu Tiếp Nhận & Xếp lịch sửa chữa theo thứ tự;
endif

:Lưu Phiếu Sửa Chữa (Status: RECEIVED);
:Chuyển giao thông tin cho Bộ phận Kỹ Thuật;

stop
@enduml
