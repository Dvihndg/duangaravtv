@startuml
left to right direction
skinparam packageStyle rectangle
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam actorBorderColor #0891b2
skinparam actorBackgroundColor #164e63
skinparam usecaseBackgroundColor #1e293b
skinparam usecaseBorderColor #38bdf8
skinparam rectangleBackgroundColor #0f172a
skinparam rectangleBorderColor #334155

actor "Lễ Tân (Receptionist)" as Receptionist
actor "Kỹ Thuật Viên (Technician)" as Technician
actor "Thu Ngân (Cashier)" as Cashier
actor "Quản Lý (Manager)" as Manager
actor "Hệ Thống AI (GarageAI Engine)" as AIEngine

rectangle "Hệ Thống Quản Lý Garage Ô Tô Tích Hợp AI" {
    usecase "UC001: Đăng ký & Tiếp nhận xe" as UC001
    usecase "UC002: Chẩn đoán & Lập báo giá nháp AI" as UC002
    usecase "UC003: Phê duyệt & Sửa chữa xe" as UC003
    usecase "UC004: Lập hóa đơn & Thanh toán VietQR" as UC004
    usecase "UC005: Quản lý kho phụ tùng & dịch vụ" as UC005
    usecase "UC006: Tư vấn Trợ lý AI Chat (GarageAI)" as UC006
    usecase "UC007: Báo cáo kinh doanh & Đánh giá AI" as UC007
}

Receptionist --> UC001
Receptionist --> UC004
Technician --> UC002
Technician --> UC003
Cashier --> UC004
Manager --> UC005
Manager --> UC007

UC002 ..> UC006 : <<include>>
UC006 --> AIEngine
UC007 --> AIEngine

@enduml
